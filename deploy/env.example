# Copy this file to /var/www/djangoapps/trainforge/trainforge/.env on the zone
# and fill in the real values. Never commit the real .env to git.

SECRET_KEY=replace-with-output-of-python-c-import-secrets-token_urlsafe-50
DEBUG=False

ALLOWED_HOSTS=infs3202-5e036019.uqcloud.net,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://infs3202-5e036019.uqcloud.net

# Forces every URL Django emits to be prefixed with /trainforge/ so it sits
# under the Nginx location block. Static URL inherits the prefix automatically.
FORCE_SCRIPT_NAME=/trainforge
USE_X_FORWARDED_HOST=1

# WhiteNoise stays available as a fallback, but Nginx serves /trainforge/static/
# directly via the alias, so the manifest storage is fine.
WHITENOISE_MANIFEST=1

# Zone-local MySQL.  Fetch <PW> with:  sudo mdata-get mysql_pw
DATABASE_URL=mysql://root:<PW>@localhost:3306/trainforge_db

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

# Optional: leave blank to disable "Continue with Google".
# Authorised redirect URI must be:
#   https://infs3202-5e036019.uqcloud.net/trainforge/accounts/google/login/callback/
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
